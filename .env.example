# 后端
HTTP_ADDR=:8080
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- 真实数据源（三项任选其一，默认 auto 会按已配置的自动挑） ----
# csv：导入企查查/天眼查导出的工商信息表
# qcc：走企查查开放平台 API
# mock：仅供开发联调，界面会挂"非真实数据"警示条，禁止对外演示
SUPPLIER_SOURCE=auto

# 方式一：导入表
# SUPPLIER_CSV=data/suppliers.csv

# 方式二：企查查开放平台
# QCC_KEY=your_key
# QCC_SECRET_KEY=your_secret
# SUPPLIER_NAMES=data/companies.txt
# SUPPLIER_CACHE=data/cache/qcc.json
# SUPPLIER_CACHE_TTL_HOURS=24

# ---- 可选：大模型（用于审核清单润色，未配置时走确定性模板） ----
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
